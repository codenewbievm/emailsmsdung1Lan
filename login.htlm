<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Temp Mail</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, onAuthStateChanged } 
        from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

        // Cấu hình Firebase của Trung
        const firebaseConfig = {
            apiKey: "AIzaSyDb1w0ZJxyTAY2usK6Agnr1ArQ_YIOGh-Y",
            authDomain: "tempmail-login-810b3.firebaseapp.com",
            projectId: "tempmail-login-810b3",
            storageBucket: "tempmail-login-810b3.firebasestorage.app",
            messagingSenderId: "821078583826",
            appId: "1:821078583826:web:04cc70bfbbc36cba6dc6cb"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);

        // Kiểm tra nếu đã đăng nhập thì về index.html
        onAuthStateChanged(auth, (user) => {
            if (user) window.location.href = 'index.html';
        });

        // Xử lý Đăng ký
        window.handleSignUp = async () => {
            const email = document.getElementById('email').value;
            const pass = document.getElementById('password').value;
            try {
                await createUserWithEmailAndPassword(auth, email, pass);
                alert("Đăng ký thành công!");
            } catch (error) {
                alert("Lỗi: " + error.message);
            }
        };

        // Xử lý Đăng nhập
        window.handleLogin = async () => {
            const email = document.getElementById('email').value;
            const pass = document.getElementById('password').value;
            try {
                await signInWithEmailAndPassword(auth, email, pass);
                window.location.href = 'index.html';
            } catch (error) {
                alert("Sai tài khoản hoặc mật khẩu!");
            }
        };
    </script>
</head>
<body class="bg-slate-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md border-t-8 border-blue-600">
        <div class="text-center mb-8">
            <i class="fas fa-envelope-open-text text-5xl text-blue-600 mb-2"></i>
            <h1 class="text-2xl font-bold text-gray-800">Chào mừng trở lại!</h1>
            <p class="text-gray-500 text-sm">Đăng nhập để sử dụng Temp Mail</p>
        </div>

        <div class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                <input type="email" id="email" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="name@email.com">
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Mật khẩu</label>
                <input type="password" id="password" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="••••••••">
            </div>
            
            <button onclick="handleLogin()" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 transition active:scale-95 shadow-lg">
                Đăng nhập
            </button>
            
            <div class="relative flex py-3 items-center">
                <div class="flex-grow border-t border-gray-300"></div>
                <span class="flex-shrink mx-4 text-gray-400 text-xs uppercase">Hoặc</span>
                <div class="flex-grow border-t border-gray-300"></div>
            </div>

            <button onclick="handleSignUp()" class="w-full bg-white text-blue-600 border-2 border-blue-600 font-bold py-3 rounded-xl hover:bg-blue-50 transition active:scale-95">
                Đăng ký tài khoản mới
            </button>
        </div>
        <p class="text-center text-gray-400 text-[10px] mt-8 uppercase tracking-widest italic">Bảo mật bởi Firebase</p>
    </div>
</body>
</html>
